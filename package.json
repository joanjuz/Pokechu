{
  "name": "pokejuegos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "data:import": "node scripts/data/import.mjs && node scripts/data/build-quiz.mjs && node scripts/data/build-grid.mjs && node scripts/data/build-pokedle.mjs",
    "data:quiz": "node scripts/data/build-quiz.mjs",
    "data:validate": "node scripts/data/validate.mjs",
    "data:recognition": "node scripts/data/build-recognition.mjs",
    "data:grid": "node scripts/data/build-grid.mjs",
    "data:pokedle": "node scripts/data/build-pokedle.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "csv-parse": "^6.1.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.0",
    "@fontsource/barlow-semi-condensed": "^5.2.0"
  }
}
